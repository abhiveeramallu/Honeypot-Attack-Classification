# Install on the PROCESSING server:
#   sudo cp cowrie-log-sync.service cowrie-log-sync.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cowrie-log-sync.timer
[Unit]
Description=Pull Cowrie honeypot logs via rsync-over-SSH
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=honeypot-pipeline
Environment=HONEYPOT_HOST=cowrie-hp01.internal
Environment=HONEYPOT_USER=cowrie
Environment=HONEYPOT_SSH_PORT=22222
Environment=SSH_KEY=/opt/honeypot-pipeline/keys/log_puller_ed25519
ExecStart=/opt/honeypot-pipeline/log_shipping/rsync_pull_logs.sh
# Don't let one hung honeypot connection block the timer indefinitely.
TimeoutStartSec=120
